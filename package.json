{
  "name": "mtpay-agent-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:test": "vite --mode test --host 0.0.0.0 --port 9529 --strictPort",
    "build:test": "vue-tsc --noEmit && vite build --mode test --outDir dist-test",
    "preview:test": "vite preview --mode test --outDir dist-test --host 0.0.0.0 --port 9530 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "crypto-js": "^4.2.0",
    "element-plus": "^2.9.1",
    "jsencrypt": "^3.5.4",
    "opencc-js": "^1.4.2",
    "pinia": "^2.3.0",
    "qrcode.vue": "^3.10.0",
    "remixicon": "^4.9.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
